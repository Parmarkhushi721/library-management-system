#define MAX_BOOKS 100
#define MAX_MEMBERS 50
#define MAX_ISSUES 100

// Book class
class Book {
public:
    int bookId;
    string title;
    string author;
    string category;
    int totalCopies;
    int availableCopies;
    
    void input() {
        cout << "\nEnter Book ID: ";
        cin >> bookId;
        cin.ignore();
        cout << "Enter Title: ";
        getline(cin, title);
        cout << "Enter Author: ";
        getline(cin, author);
        cout << "Enter Category (Fiction/Non-Fiction/Science/History): ";
        getline(cin, category);
        cout << "Enter Total Copies: ";
        cin >> totalCopies;
        availableCopies = totalCopies;
    }
    
    void display() const {
        cout << left << setw(8) << bookId
             << setw(25) << title
             << setw(20) << author
             << setw(15) << category
             << setw(8) << totalCopies
             << setw(10) << availableCopies << endl;
    }
};

// Member class
class Member {
public:
    int memberId;
    string name;
    string email;
    string phone;
    string membershipDate;
    int booksIssued;
    
    void input() {
        cout << "\nEnter Member ID: ";
        cin >> memberId;
        cin.ignore();
        cout << "Enter Name: ";
        getline(cin, name);
        cout << "Enter Email: ";
        getline(cin, email);
        cout << "Enter Phone: ";
        getline(cin, phone);
        
        // Auto-set current date as membership date
        time_t now = time(0);
        tm* ltm = localtime(&now);
        membershipDate = to_string(ltm->tm_mday) + "/" + 
                        to_string(1 + ltm->tm_mon) + "/" + 
                        to_string(1900 + ltm->tm_year);
        booksIssued = 0;
    }
    
    void display() const {
        cout << left << setw(10) << memberId
             << setw(20) << name
             << setw(25) << email
             << setw(15) << phone
             << setw(12) << membershipDate
             << setw(10) << booksIssued << endl;
    }
};

// Issue Record class
class IssueRecord {
public:
    int issueId;
    int bookId;
    int memberId;
    string issueDate;
    string returnDate;
    bool isReturned;
    
    void createIssue(int iId, int bId, int mId) {
        issueId = iId;
        bookId = bId;
        memberId = mId;
        
        // Set current date as issue date
        time_t now = time(0);
        tm* ltm = localtime(&now);
        issueDate = to_string(ltm->tm_mday) + "/" + 
                   to_string(1 + ltm->tm_mon) + "/" + 
                   to_string(1900 + ltm->tm_year);
        
        // Set return date as 14 days from issue date
        returnDate = "Due in 14 days";
        isReturned = false;
    }
    
    void display() const {
        cout << left << setw(10) << issueId
             << setw(10) << bookId
             << setw(10) << memberId
             << setw(15) << issueDate
             << setw(15) << returnDate
             << setw(10) << (isReturned ? "Returned" : "Pending") << endl;
    }
};

// Global arrays and counters
Book books[MAX_BOOKS];
Member members[MAX_MEMBERS];
IssueRecord issues[MAX_ISSUES];
int bookCount = 0;
int memberCount = 0;
int issueCount = 0;

// File names
string bookFile = "books.txt";
string memberFile = "members.txt";
string issueFile = "issues.txt";

// Function to load books from file
void loadBooks() {
    ifstream file(bookFile);
    if (!file) return;
    
    bookCount = 0;
    while (file >> books[bookCount].bookId) {
        file.ignore();
        getline(file, books[bookCount].title);
        getline(file, books[bookCount].author);
        getline(file, books[bookCount].category);
        file >> books[bookCount].totalCopies;
        file >> books[bookCount].availableCopies;
        file.ignore();
        bookCount++;
        if (bookCount >= MAX_BOOKS) break;
    }
    file.close();
}

// Function to save books to file
void saveBooks() {
    ofstream file(bookFile);
    for (int i = 0; i < bookCount; i++) {
        file << books[i].bookId << "\n"
             << books[i].title << "\n"
             << books[i].author << "\n"
             << books[i].category << "\n"
             << books[i].totalCopies << "\n"
             << books[i].availableCopies << "\n";
    }
    file.close();
}

// Function to load members from file
void loadMembers() {
    ifstream file(memberFile);
    if (!file) return;
    
    memberCount = 0;
    while (file >> members[memberCount].memberId) {
        file.ignore();
        getline(file, members[memberCount].name);
        getline(file, members[memberCount].email);
        getline(file, members[memberCount].phone);
        getline(file, members[memberCount].membershipDate);
        file >> members[memberCount].booksIssued;
        file.ignore();
        memberCount++;
        if (memberCount >= MAX_MEMBERS) break;
    }
    file.close();
}

// Function to save members to file
void saveMembers() {
    ofstream file(memberFile);
    for (int i = 0; i < memberCount; i++) {
        file << members[i].memberId << "\n"
             << members[i].name << "\n"
             << members[i].email << "\n"
             << members[i].phone << "\n"
             << members[i].membershipDate << "\n"
             << members[i].booksIssued << "\n";
    }
    file.close();
}

// Function to load issue records from file
void loadIssues() {
    ifstream file(issueFile);
    if (!file) return;
    
    issueCount = 0;
    while (file >> issues[issueCount].issueId) {
        file >> issues[issueCount].bookId;
        file >> issues[issueCount].memberId;
        file.ignore();
        getline(file, issues[issueCount].issueDate);
        getline(file, issues[issueCount].returnDate);
        file >> issues[issueCount].isReturned;
        file.ignore();
        issueCount++;
        if (issueCount >= MAX_ISSUES) break;
    }
    file.close();
}

// Function to save issue records to file
void saveIssues() {
    ofstream file(issueFile);
    for (int i = 0; i < issueCount; i++) {
        file << issues[i].issueId << "\n"
             << issues[i].bookId << "\n"
             << issues[i].memberId << "\n"
             << issues[i].issueDate << "\n"
             << issues[i].returnDate << "\n"
             << issues[i].isReturned << "\n";
    }
    file.close();
}

// Book Management Functions
void addBook() {
    if (bookCount >= MAX_BOOKS) {
        cout << "\nBook database full! Cannot add more books.\n";
        return;
    }
    
    Book b;
    b.input();
    
    // Check if book ID already exists
    for (int i = 0; i < bookCount; i++) {
        if (books[i].bookId == b.bookId) {
            cout << "\nBook ID already exists! Use a different ID.\n";
            return;
        }
    }
    
    books[bookCount++] = b;
    saveBooks();
    cout << "\nBook added successfully!\n";
}

void displayBooks() {
    if (bookCount == 0) {
        cout << "\nNo books in the library!\n";
        return;
    }
    
    cout << "\n=============== BOOK INVENTORY ===============\n";
    cout << left << setw(8) << "ID"
         << setw(25) << "Title"
         << setw(20) << "Author"
         << setw(15) << "Category"
         << setw(8) << "Total"
         << setw(10) << "Available" << endl;
    cout << string(86, '-') << endl;
    
    for (int i = 0; i < bookCount; i++) {
        books[i].display();
    }
    cout << "\nTotal Books in Library: " << bookCount << endl;
}

void searchBook() {
    int choice;
    cout << "\nSearch by:\n";
    cout << "1. Book ID\n";
    cout << "2. Title\n";
    cout << "3. Author\n";
    cout << "Enter choice: ";
    cin >> choice;
    cin.ignore();
    
    bool found = false;
    
    if (choice == 1) {
        int id;
        cout << "Enter Book ID: ";
        cin >> id;
        
        for (int i = 0; i < bookCount; i++) {
            if (books[i].bookId == id) {
                cout << "\n--- Book Found ---\n";
                cout << "ID: " << books[i].bookId << endl;
                cout << "Title: " << books[i].title << endl;
                cout << "Author: " << books[i].author << endl;
                cout << "Category: " << books[i].category << endl;
                cout << "Total Copies: " << books[i].totalCopies << endl;
                cout << "Available: " << books[i].availableCopies << endl;
                found = true;
                break;
            }
        }
    }
    else if (choice == 2) {
        string title;
        cout << "Enter Title (partial match): ";
        getline(cin, title);
        
        cout << "\n--- Search Results ---\n";
        for (int i = 0; i < bookCount; i++) {
            if (books[i].title.find(title) != string::npos) {
                books[i].display();
                found = true;
            }
        }
    }
    else if (choice == 3) {
        string author;
        cout << "Enter Author name (partial match): ";
        getline(cin, author);
        
        cout << "\n--- Search Results ---\n";
        for (int i = 0; i < bookCount; i++) {
            if (books[i].author.find(author) != string::npos) {
                books[i].display();
                found = true;
            }
        }
    }
    
    if (!found) {
        cout << "\nNo books found matching your search!\n";
    }
}

// Member Management Functions
void addMember() {
    if (memberCount >= MAX_MEMBERS) {
        cout << "\nMember database full! Cannot add more members.\n";
        return;
    }
    
    Member m;
    m.input();
    
    // Check if member ID already exists
