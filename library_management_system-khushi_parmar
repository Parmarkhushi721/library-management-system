// Issue and Return Functions
void issueBook() {
    int bookId, memberId;
    
    cout << "\nEnter Book ID to issue: ";
    cin >> bookId;
    cout << "Enter Member ID: ";
    cin >> memberId;
    
    // Find book
    int bookIndex = -1;
    for (int i = 0; i < bookCount; i++) {
        if (books[i].bookId == bookId) {
            bookIndex = i;
            break;
        }
    }
    
    if (bookIndex == -1) {
        cout << "\nBook not found!\n";
        return;
    }
    
    // Check availability
    if (books[bookIndex].availableCopies <= 0) {
        cout << "\nBook not available! All copies are issued.\n";
        return;
    }
    
    // Find member
    int memberIndex = -1;
    for (int i = 0; i < memberCount; i++) {
        if (members[i].memberId == memberId) {
            memberIndex = i;
            break;
        }
    }
    
    if (memberIndex == -1) {
        cout << "\nMember not found!\n";
        return;
    }
    
    // Check member book limit (max 3 books)
    if (members[memberIndex].booksIssued >= 3) {
        cout << "\nMember has already issued maximum books (3)!\n";
        return;
    }
    
    // Create issue record
    IssueRecord issue;
    issue.createIssue(issueCount + 1, bookId, memberId);
    issues[issueCount++] = issue;
    
    // Update book and member records
    books[bookIndex].availableCopies--;
    members[memberIndex].booksIssued++;
    
    // Save all changes
    saveBooks();
    saveMembers();
    saveIssues();
    
    cout << "\n===== BOOK ISSUED SUCCESSFULLY =====\n";
    cout << "Issue ID: " << issue.issueId << endl;
    cout << "Book: " << books[bookIndex].title << endl;
    cout << "Member: " << members[memberIndex].name << endl;
    cout << "Issue Date: " << issue.issueDate << endl;
    cout << "Return Date: " << issue.returnDate << endl;
    cout << "=====================================\n";
}

void returnBook() {
    int issueId;
    cout << "\nEnter Issue ID to return: ";
    cin >> issueId;
    
    // Find issue record
    int issueIndex = -1;
    for (int i = 0; i < issueCount; i++) {
        if (issues[i].issueId == issueId && !issues[i].isReturned) {
            issueIndex = i;
            break;
        }
    }
    
    if (issueIndex == -1) {
        cout << "\nIssue record not found or already returned!\n";
        return;
    }
    
    // Find book and member
    int bookIndex = -1, memberIndex = -1;
    for (int i = 0; i < bookCount; i++) {
        if (books[i].bookId == issues[issueIndex].bookId) {
            bookIndex = i;
            break;
        }
    }
    
    for (int i = 0; i < memberCount; i++) {
        if (members[i].memberId == issues[issueIndex].memberId) {
            memberIndex = i;
            break;
        }
    }
    
    // Update records
    issues[issueIndex].isReturned = true;
    books[bookIndex].availableCopies++;
    members[memberIndex].booksIssued--;
    
    // Save changes
    saveBooks();
    saveMembers();
    saveIssues();
    
    cout << "\n===== BOOK RETURNED SUCCESSFULLY =====\n";
    cout << "Book: " << books[bookIndex].title << endl;
    cout << "Member: " << members[memberIndex].name << endl;
    cout << "=======================================\n";
}

void displayIssueRecords() {
    if (issueCount == 0) {
        cout << "\nNo issue records found!\n";
        return;
    }
    
    cout << "\n=============== ISSUE RECORDS ===============\n";
    cout << left << setw(10) << "Issue ID"
         << setw(10) << "Book ID"
         << setw(10) << "Member ID"
         << setw(15) << "Issue Date"
         << setw(15) << "Return Date"
         << setw(10) << "Status" << endl;
    cout << string(70, '-') << endl;
    
    for (int i = 0; i < issueCount; i++) {
        issues[i].display();
    }
    
    // Count pending returns
    int pending = 0;
    for (int i = 0; i < issueCount; i++) {
        if (!issues[i].isReturned) pending++;
    }
    
    cout << "\nTotal Issues: " << issueCount << endl;
    cout << "Pending Returns: " << pending << endl;
}

// Reports and Statistics
void generateReport() {
    cout << "\n========== LIBRARY STATISTICS ==========\n";
    
    // Book Statistics
    int totalBooks = 0, totalAvailable = 0, totalIssued = 0;
    for (int i = 0; i < bookCount; i++) {
        totalBooks += books[i].totalCopies;
        totalAvailable += books[i].availableCopies;
        totalIssued += (books[i].totalCopies - books[i].availableCopies);
    }
    
    cout << "\nBOOK STATISTICS:\n";
    cout << "Total Book Titles: " << bookCount << endl;
    cout << "Total Book Copies: " << totalBooks << endl;
    cout << "Books Available: " << totalAvailable << endl;
    cout << "Books Issued: " << totalIssued << endl;
    
    // Member Statistics
    cout << "\nMEMBER STATISTICS:\n";
    cout << "Total Members: " << memberCount << endl;
    
    int activeMembers = 0;
    for (int i = 0; i < memberCount; i++) {
        if (members[i].booksIssued > 0) activeMembers++;
    }
    cout << "Active Members (with books): " << activeMembers << endl;
    
    // Issue Statistics
    int pendingReturns = 0;
    for (int i = 0; i < issueCount; i++) {
        if (!issues[i].isReturned) pendingReturns++;
    }
    
    cout << "\nISSUE STATISTICS:\n";
    cout << "Total Issues: " << issueCount << endl;
    cout << "Pending Returns: " << pendingReturns << endl;
    cout << "Completed Returns: " << (issueCount - pendingReturns) << endl;
    
    // Most Popular Books (most issued)
    cout << "\nMOST ISSUED BOOKS:\n";
    for (int i = 0; i < bookCount && i < 5; i++) {
        int issued = books[i].totalCopies - books[i].availableCopies;
        if (issued > 0) {
            cout << "- " << books[i].title << " (" << issued << " copies issued)\n";
        }
    }
    
    cout << "\n=========================================\n";
}

